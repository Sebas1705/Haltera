{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./androidApp/google-services.json)",
      "Read(./iosApp/iosApp/GoogleService-Info.plist)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/secrets.properties)",
      "Read(./.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git * --no-verify*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-guard.mjs\""
          }
        ]
      }
    ]
  }
}
