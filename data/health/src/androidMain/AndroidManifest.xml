<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect needs API 26 to build and API 28 to run; HealthConnectGateway reports anything older as
         unsupported before touching the library, so the app keeps minSdk 24. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <!-- Only the data types Haltera implements (docs/play/DATA-INVENTORY.md, PLAY-CONSOLE-GUIDE.md). Each is
         requested only when the user turns its switch on and taps Connect. No background or history permission. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />

    <!-- Android 9-13: Health Connect is an app; the client must see it to bind to it. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
