-- Base exercises (spec §3.1). Catalogue rows are owned by the importer; USER rows by the user.
CREATE TABLE ExerciseEntity (
    id               TEXT NOT NULL PRIMARY KEY,
    source           TEXT NOT NULL,              -- CATALOG | USER
    nameEn           TEXT NOT NULL,
    nameEs           TEXT NOT NULL,
    nameEnSearch     TEXT NOT NULL DEFAULT '',   -- lower case without accents (SearchText.normalize)
    nameEsSearch     TEXT NOT NULL DEFAULT '',
    category         TEXT NOT NULL,
    trackingType     TEXT NOT NULL,
    level            TEXT NOT NULL,
    primaryMuscles   TEXT NOT NULL,              -- comma-separated Muscle names
    secondaryMuscles TEXT NOT NULL,
    instructionsEn   TEXT NOT NULL,              -- JSON array of steps
    instructionsEs   TEXT NOT NULL,
    deprecated       INTEGER NOT NULL DEFAULT 0, -- 0/1; a USER row with history is soft-deleted this way
    updatedAt        INTEGER NOT NULL,           -- epoch millis
    author           TEXT,                       -- schema 6: creator of a USER exercise imported from a shared routine
    originId         TEXT                        -- schema 6: id of the exercise on the creator's device (import dedupe)
);

CREATE INDEX ExerciseEntity_originId ON ExerciseEntity(originId);

-- OR IGNORE is meant only for primary-key conflicts (row already present: the importer then runs updateCatalog).
-- It would also silently swallow UNIQUE, NOT NULL or CHECK violations: revisit it before adding such constraints.
insertCatalogIfMissing:
INSERT OR IGNORE INTO ExerciseEntity(
    id, source, nameEn, nameEs, nameEnSearch, nameEsSearch, category, trackingType, level,
    primaryMuscles, secondaryMuscles, instructionsEn, instructionsEs, deprecated, updatedAt
) VALUES (
    :id, 'CATALOG', :nameEn, :nameEs, :nameEnSearch, :nameEsSearch, :category, :trackingType, :level,
    :primaryMuscles, :secondaryMuscles, :instructionsEn, :instructionsEs, 0, :updatedAt
);

updateCatalog:
UPDATE ExerciseEntity
SET nameEn = :nameEn, nameEs = :nameEs, nameEnSearch = :nameEnSearch, nameEsSearch = :nameEsSearch,
    category = :category, trackingType = :trackingType, level = :level,
    primaryMuscles = :primaryMuscles, secondaryMuscles = :secondaryMuscles,
    instructionsEn = :instructionsEn, instructionsEs = :instructionsEs, deprecated = 0, updatedAt = :updatedAt
WHERE id = :id AND source = 'CATALOG';

deprecate:
UPDATE ExerciseEntity SET deprecated = 1, updatedAt = :updatedAt
WHERE id = :id AND source = 'CATALOG';

insertUser:
INSERT INTO ExerciseEntity(
    id, source, nameEn, nameEs, nameEnSearch, nameEsSearch, category, trackingType, level,
    primaryMuscles, secondaryMuscles, instructionsEn, instructionsEs, deprecated, updatedAt
) VALUES (
    :id, 'USER', :nameEn, :nameEs, :nameEnSearch, :nameEsSearch, :category, :trackingType, :level,
    :primaryMuscles, :secondaryMuscles, :instructionsEn, :instructionsEs, 0, :updatedAt
);

selectById:
SELECT * FROM ExerciseEntity WHERE id = ?;

selectByIds:
SELECT * FROM ExerciseEntity WHERE id IN ?;

countActive:
SELECT COUNT(*) FROM ExerciseEntity WHERE deprecated = 0;

-- Exercise list (spec §7). :query is already normalised (SearchText.normalize); '' matches everything.
-- The repository calls it with '' only (browsing with filters); text queries are ranked in memory by ExerciseSearch.
-- :muscle matches primary muscles only; :equipment matches any active variant with that equipment.
-- Order: with a query, names starting with it, then names with a word starting with it, then the rest; without
-- one, the exercises the user logged most, then strength and calisthenics before stretches and cardio. Ties
-- by name.
search:
SELECT * FROM ExerciseEntity
WHERE deprecated = 0
  AND (:query = '' OR nameEnSearch LIKE '%' || :query || '%' OR nameEsSearch LIKE '%' || :query || '%')
  AND (:category IS NULL OR category = :category)
  AND (:muscle IS NULL OR (',' || primaryMuscles || ',') LIKE '%,' || :muscle || ',%')
  AND (:equipment IS NULL OR EXISTS (
        SELECT 1 FROM ExerciseVariantEntity v
        WHERE v.exerciseId = ExerciseEntity.id AND v.deprecated = 0 AND v.equipment = :equipment
  ))
-- Matches on the name in the app language rank first: exact, then prefix, then a word start, then the rest.
ORDER BY
  CASE
    WHEN :query = '' THEN 0
    WHEN (CASE WHEN :language = 'es' THEN nameEsSearch ELSE nameEnSearch END) = :query THEN 0
    WHEN (CASE WHEN :language = 'es' THEN nameEsSearch ELSE nameEnSearch END) LIKE :query || '%' THEN 1
    WHEN (' ' || (CASE WHEN :language = 'es' THEN nameEsSearch ELSE nameEnSearch END)) LIKE '% ' || :query || '%' THEN 2
    ELSE 3
  END,
  CASE WHEN :query = '' THEN -(
    SELECT COUNT(*) FROM SessionExerciseEntity se
    JOIN ExerciseVariantEntity uv ON uv.id = se.variantId
    WHERE uv.exerciseId = ExerciseEntity.id
      AND EXISTS (SELECT 1 FROM SetLogEntity sl WHERE sl.sessionExerciseId = se.id AND sl.completed = 1)
  ) ELSE 0 END,
  CASE WHEN :query = '' AND category NOT IN ('STRENGTH', 'CALISTHENICS') THEN 1 ELSE 0 END,
  CASE WHEN :language = 'es' THEN nameEsSearch ELSE nameEnSearch END,
  id
LIMIT :limit;

-- Data export: the exercises the user created (the bundled catalogue is never exported).
selectUser:
SELECT * FROM ExerciseEntity WHERE source = 'USER' ORDER BY id;

-- Fuzzy search (ExerciseSearch, docs/designs/2026-10-16-fuzzy-search-design.md): every active exercise; the
-- repository ranks them in memory and applies the filters.
selectActive:
SELECT * FROM ExerciseEntity WHERE deprecated = 0 ORDER BY id;

-- Per exercise: sessions in which the user completed a set of it, and the start of the latest one (search boost).
usageStats:
SELECT uv.exerciseId, COUNT(DISTINCT se.sessionId) AS sessions, MAX(ws.startedAt) AS lastStartedAt
FROM SessionExerciseEntity se
JOIN ExerciseVariantEntity uv ON uv.id = se.variantId
JOIN WorkoutSessionEntity ws ON ws.id = se.sessionId
WHERE EXISTS (SELECT 1 FROM SetLogEntity sl WHERE sl.sessionExerciseId = se.id AND sl.completed = 1)
GROUP BY uv.exerciseId;

-- Custom exercises (core design §3.1.1): edit, soft delete, delete and the origin of a shared one.
updateUser:
UPDATE ExerciseEntity
SET nameEn = :nameEn, nameEs = :nameEs, nameEnSearch = :nameEnSearch, nameEsSearch = :nameEsSearch,
    category = :category, trackingType = :trackingType, level = :level,
    primaryMuscles = :primaryMuscles, secondaryMuscles = :secondaryMuscles,
    instructionsEn = :instructionsEn, instructionsEs = :instructionsEs, updatedAt = :updatedAt
WHERE id = :id AND source = 'USER';

setUserDeprecated:
UPDATE ExerciseEntity SET deprecated = :deprecated, updatedAt = :updatedAt WHERE id = :id AND source = 'USER';

setShareOrigin:
UPDATE ExerciseEntity SET author = :author, originId = :originId WHERE id = :id AND source = 'USER';

deleteUser:
DELETE FROM ExerciseEntity WHERE id = ? AND source = 'USER';

-- The USER exercise a shared exercise was already imported as (its originId), or the user's own exercise
-- when they import a routine they shared themselves (its id). Live rows first.
selectUserByOrigin:
SELECT * FROM ExerciseEntity
WHERE source = 'USER' AND (originId = :origin OR id = :origin)
ORDER BY deprecated, id
LIMIT 1;

-- Variants of the exercise referenced by a session exercise (any, even without completed sets): they cannot
-- be deleted (foreign key) and they hold history.
variantsInSessions:
SELECT DISTINCT se.variantId FROM SessionExerciseEntity se
JOIN ExerciseVariantEntity v ON v.id = se.variantId
WHERE v.exerciseId = ?;

-- Sessions and completed sets that logged the exercise.
historyCounts:
SELECT COUNT(DISTINCT se.sessionId) AS sessions, COUNT(sl.id) AS sets
FROM SessionExerciseEntity se
JOIN ExerciseVariantEntity v ON v.id = se.variantId
LEFT JOIN SetLogEntity sl ON sl.sessionExerciseId = se.id AND sl.completed = 1
WHERE v.exerciseId = ?;

-- Routine slots whose target JSON mentions :exerciseId (its variant ids start with it); callers check the target.
slotsMentioning:
SELECT s.id, s.dayId, s.target, d.routineId, r.name AS routineName
FROM RoutineSlotEntity s
JOIN RoutineDayEntity d ON d.id = s.dayId
JOIN RoutineEntity r ON r.id = d.routineId
WHERE s.target LIKE '%' || :exerciseId || '%'
ORDER BY r.name, r.id;
