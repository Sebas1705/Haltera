-- Exercises performed in a session with the variant actually used.
CREATE TABLE SessionExerciseEntity (
    id        TEXT NOT NULL PRIMARY KEY,
    sessionId TEXT NOT NULL REFERENCES WorkoutSessionEntity(id) ON DELETE CASCADE,
    position  INTEGER NOT NULL,
    variantId TEXT NOT NULL REFERENCES ExerciseVariantEntity(id),
    slotId    TEXT REFERENCES RoutineSlotEntity(id) ON DELETE SET NULL, -- null: added ad hoc
    notes     TEXT NOT NULL DEFAULT '',
    -- 0/1: the dumbbell volume counts both hands. A snapshot of the slot's "Both hands" flag taken when the exercise
    -- was logged (core design §3.3); later edits or the removal of the slot never change it.
    bilateral INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX SessionExerciseEntity_sessionId ON SessionExerciseEntity(sessionId, position);
CREATE INDEX SessionExerciseEntity_variantId ON SessionExerciseEntity(variantId);
CREATE INDEX SessionExerciseEntity_slotId ON SessionExerciseEntity(slotId);

-- A live or past session logging an exercise: the "Both hands" flag of its slot (if any) is snapshotted now.
insert:
INSERT INTO SessionExerciseEntity(id, sessionId, position, variantId, slotId, notes, bilateral)
VALUES (:id, :sessionId, :position, :variantId, :slotId, '',
    COALESCE((SELECT s.bilateral FROM RoutineSlotEntity s WHERE s.id = :slotId), 0));

setVariant:
UPDATE SessionExerciseEntity SET variantId = :variantId WHERE id = :id;

setPosition:
UPDATE SessionExerciseEntity SET position = :position WHERE id = :id;

updateNotes:
UPDATE SessionExerciseEntity SET notes = :notes WHERE id = :id;

delete:
DELETE FROM SessionExerciseEntity WHERE id = ?;

selectById:
SELECT * FROM SessionExerciseEntity WHERE id = ?;

selectBySession:
SELECT * FROM SessionExerciseEntity WHERE sessionId = ? ORDER BY position;

selectBySessions:
SELECT * FROM SessionExerciseEntity WHERE sessionId IN ? ORDER BY sessionId, position;

-- History of a variant in finished sessions started before :before, latest first. Here and below only
-- performances with a completed set count (older saves may keep exercises left empty).
historyByVariant:
SELECT se.*, s.startedAt AS sessionStartedAt
FROM SessionExerciseEntity se JOIN WorkoutSessionEntity s ON s.id = se.sessionId
WHERE se.variantId = :variantId AND s.endedAt IS NOT NULL AND s.startedAt < :before
  AND EXISTS (SELECT 1 FROM SetLogEntity sl WHERE sl.sessionExerciseId = se.id AND sl.completed = 1)
ORDER BY s.startedAt DESC, se.position DESC
LIMIT :limit;

-- History of every variant of an exercise in finished sessions started before :before, latest first.
historyByExercise:
SELECT se.*, s.startedAt AS sessionStartedAt
FROM SessionExerciseEntity se
JOIN WorkoutSessionEntity s ON s.id = se.sessionId
JOIN ExerciseVariantEntity v ON v.id = se.variantId
WHERE v.exerciseId = :exerciseId AND s.endedAt IS NOT NULL AND s.startedAt < :before
  AND EXISTS (SELECT 1 FROM SetLogEntity sl WHERE sl.sessionExerciseId = se.id AND sl.completed = 1)
ORDER BY s.startedAt DESC, se.position DESC
LIMIT :limit;

-- History of a routine slot with one variant in finished sessions started before :before, latest first
-- (progression input).
historyBySlotAndVariant:
SELECT se.*, s.startedAt AS sessionStartedAt
FROM SessionExerciseEntity se JOIN WorkoutSessionEntity s ON s.id = se.sessionId
WHERE se.slotId = :slotId AND se.variantId = :variantId AND s.endedAt IS NOT NULL AND s.startedAt < :before
  AND EXISTS (SELECT 1 FROM SetLogEntity sl WHERE sl.sessionExerciseId = se.id AND sl.completed = 1)
ORDER BY s.startedAt DESC, se.position DESC
LIMIT :limit;

-- The most recently used of :variantIds in any finished session (any slot, routine or free session) started
-- before :before, counting only performances with a completed working set (flexible-slot default).
lastUsedVariant:
SELECT se.variantId
FROM SessionExerciseEntity se
JOIN WorkoutSessionEntity s ON s.id = se.sessionId
WHERE se.variantId IN :variantIds AND s.endedAt IS NOT NULL AND s.startedAt < :before
  AND EXISTS (
    SELECT 1 FROM SetLogEntity sl
    WHERE sl.sessionExerciseId = se.id AND sl.kind = 'WORKING' AND sl.completed = 1
  )
ORDER BY s.startedAt DESC, se.position DESC
LIMIT 1;

-- History import: an exercise of an imported session with its notes, the slot it is linked to (null when the file
-- names none or the slot does not exist here) and its "Both hands" snapshot from the file.
insertImported:
INSERT INTO SessionExerciseEntity(id, sessionId, position, variantId, slotId, notes, bilateral) VALUES (?, ?, ?, ?, ?, ?, ?);

-- The start and end of the session an exercise belongs to: a set ticked in a finished session gets a completion time
-- inside it, never "now" (a past session logged days later).
sessionTimes:
SELECT s.startedAt, s.endedAt
FROM SessionExerciseEntity se JOIN WorkoutSessionEntity s ON s.id = se.sessionId
WHERE se.id = :id;
