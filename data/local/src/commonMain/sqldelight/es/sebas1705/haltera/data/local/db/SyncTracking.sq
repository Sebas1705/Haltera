CREATE TRIGGER ExerciseEntity_syncInsert
AFTER INSERT ON ExerciseEntity
WHEN new.source = 'USER' AND (SELECT value FROM Meta WHERE key = 'syncApplying') IS NOT '1'
BEGIN
    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = 0
    WHERE collection = 'exercises' AND id = new.id;
    INSERT INTO SyncState(collection, id, updatedAt, dirty, deleted)
    SELECT 'exercises', new.id, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), 1, 0
    WHERE new.id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'exercises' AND s.id = new.id);
END;

