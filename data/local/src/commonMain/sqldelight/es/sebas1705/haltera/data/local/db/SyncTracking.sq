-- Nutrition (schema 4). A food document holds a recipe with its items; a day document all the entries of
-- the date (deleted when its last entry goes). OFF foods are tracked from their first use in a day or recipe.

CREATE TRIGGER FoodEntity_syncInsert
AFTER INSERT ON FoodEntity
WHEN (new.source IN ('USER', 'RECIPE') OR (new.source = 'OFF' AND EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'foods' AND s.id = new.id))) AND (SELECT value FROM Meta WHERE key = 'syncApplying') IS NOT '1'
BEGIN
    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = 0
    WHERE collection = 'foods' AND id = new.id;
    INSERT INTO SyncState(collection, id, updatedAt, dirty, deleted)
    SELECT 'foods', new.id, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), 1, 0
    WHERE new.id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'foods' AND s.id = new.id);
END;

CREATE TRIGGER FoodEntity_syncUpdate
AFTER UPDATE ON FoodEntity
WHEN (new.source IN ('USER', 'RECIPE') OR (new.source = 'OFF' AND EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'foods' AND s.id = new.id))) AND (SELECT value FROM Meta WHERE key = 'syncApplying') IS NOT '1'
BEGIN
    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = 0
    WHERE collection = 'foods' AND id = new.id;
    INSERT INTO SyncState(collection, id, updatedAt, dirty, deleted)
    SELECT 'foods', new.id, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), 1, 0
    WHERE new.id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'foods' AND s.id = new.id);
END;

CREATE TRIGGER FoodEntity_syncDelete
AFTER DELETE ON FoodEntity
WHEN (old.source IN ('USER', 'RECIPE') OR (old.source = 'OFF' AND EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'foods' AND s.id = old.id))) AND (SELECT value FROM Meta WHERE key = 'syncApplying') IS NOT '1'
BEGIN
    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = 1
    WHERE collection = 'foods' AND id = old.id;
    INSERT INTO SyncState(collection, id, updatedAt, dirty, deleted)
    SELECT 'foods', old.id, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), 1, 1
    WHERE old.id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'foods' AND s.id = old.id);
END;

