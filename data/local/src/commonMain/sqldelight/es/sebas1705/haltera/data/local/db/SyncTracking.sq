AFTER UPDATE ON ExerciseEntity
WHEN new.source = 'USER' AND (SELECT value FROM Meta WHERE key = 'syncApplying') IS NOT '1'
BEGIN
    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = 0
    WHERE collection = 'exercises' AND id = new.id;
    INSERT INTO SyncState(collection, id, updatedAt, dirty, deleted)
    SELECT 'exercises', new.id, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), 1, 0
    WHERE new.id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'exercises' AND s.id = new.id);
END;

CREATE TRIGGER ExerciseEntity_syncDelete
AFTER DELETE ON ExerciseEntity
WHEN old.source = 'USER' AND (SELECT value FROM Meta WHERE key = 'syncApplying') IS NOT '1'
BEGIN
    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = 1
    WHERE collection = 'exercises' AND id = old.id;
    INSERT INTO SyncState(collection, id, updatedAt, dirty, deleted)
    SELECT 'exercises', old.id, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), 1, 1
    WHERE old.id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'exercises' AND s.id = old.id);
END;

CREATE TRIGGER RoutineDayEntity_syncInsert
AFTER INSERT ON RoutineDayEntity
WHEN (SELECT value FROM Meta WHERE key = 'syncApplying') IS NOT '1'
BEGIN
    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = CASE WHEN EXISTS (SELECT 1 FROM RoutineEntity p WHERE p.id = new.routineId) THEN 0 ELSE 1 END
    WHERE collection = 'routines' AND id = new.routineId;
    INSERT INTO SyncState(collection, id, updatedAt, dirty, deleted)
    SELECT 'routines', new.routineId, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), 1, CASE WHEN EXISTS (SELECT 1 FROM RoutineEntity p WHERE p.id = new.routineId) THEN 0 ELSE 1 END
    WHERE new.routineId IS NOT NULL AND NOT EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'routines' AND s.id = new.routineId);
END;

CREATE TRIGGER RoutineDayEntity_syncUpdate
AFTER UPDATE ON RoutineDayEntity
WHEN (SELECT value FROM Meta WHERE key = 'syncApplying') IS NOT '1'
BEGIN
    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = CASE WHEN EXISTS (SELECT 1 FROM RoutineEntity p WHERE p.id = new.routineId) THEN 0 ELSE 1 END
    WHERE collection = 'routines' AND id = new.routineId;
    INSERT INTO SyncState(collection, id, updatedAt, dirty, deleted)
    SELECT 'routines', new.routineId, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), 1, CASE WHEN EXISTS (SELECT 1 FROM RoutineEntity p WHERE p.id = new.routineId) THEN 0 ELSE 1 END
    WHERE new.routineId IS NOT NULL AND NOT EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'routines' AND s.id = new.routineId);
END;

CREATE TRIGGER RoutineDayEntity_syncDelete
AFTER DELETE ON RoutineDayEntity
WHEN (SELECT value FROM Meta WHERE key = 'syncApplying') IS NOT '1'
BEGIN
    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = CASE WHEN EXISTS (SELECT 1 FROM RoutineEntity p WHERE p.id = old.routineId) THEN 0 ELSE 1 END
    WHERE collection = 'routines' AND id = old.routineId;
