    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = 0
    WHERE collection = 'settings' AND id = 'user';
    INSERT INTO SyncState(collection, id, updatedAt, dirty, deleted)
    SELECT 'settings', 'user', CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), 1, 0
    WHERE 'user' IS NOT NULL AND NOT EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'settings' AND s.id = 'user');
END;

