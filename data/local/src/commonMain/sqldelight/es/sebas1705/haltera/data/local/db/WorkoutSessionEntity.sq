-- Workouts (spec §3.3). endedAt IS NULL means in progress; the calendar is derived from startedAt.
CREATE TABLE WorkoutSessionEntity (
    id              TEXT NOT NULL PRIMARY KEY,
    startedAt       INTEGER NOT NULL,            -- epoch millis
    endedAt         INTEGER,
    routineId       TEXT REFERENCES RoutineEntity(id) ON DELETE SET NULL,
    routineDayIndex INTEGER,
    dayName         TEXT,                        -- snapshot of the routine day name
    notes           TEXT NOT NULL DEFAULT '',
    bodyWeightGrams INTEGER,
    -- Name of the routine the session was logged from: follows renames while the routine exists and is kept when
    -- it is deleted (routineId is then cleared), so the session keeps its title. Null for a free session.
    routineName     TEXT
);

CREATE INDEX WorkoutSessionEntity_startedAt ON WorkoutSessionEntity(startedAt);

-- A deleted routine leaves its sessions without a routine, so they no longer point at one of its days either.
CREATE TRIGGER RoutineEntity_clearSessionDays
BEFORE DELETE ON RoutineEntity
BEGIN
    UPDATE WorkoutSessionEntity SET routineDayIndex = NULL WHERE routineId = old.id;
END;

insert:
INSERT INTO WorkoutSessionEntity(id, startedAt, endedAt, routineId, routineDayIndex, dayName, notes, bodyWeightGrams, routineName)
VALUES (:id, :startedAt, NULL, :routineId, :routineDayIndex, :dayName, '', NULL,
    (SELECT r.name FROM RoutineEntity r WHERE r.id = :routineId));

finish:
UPDATE WorkoutSessionEntity SET endedAt = :endedAt WHERE id = :id AND endedAt IS NULL;

-- Start and end can be changed at any time: everything stays editable.
updateTimes:
UPDATE WorkoutSessionEntity SET startedAt = :startedAt, endedAt = :endedAt WHERE id = :id;

updateNotes:
UPDATE WorkoutSessionEntity SET notes = :notes WHERE id = :id;

delete:
DELETE FROM WorkoutSessionEntity WHERE id = ?;

selectById:
SELECT * FROM WorkoutSessionEntity WHERE id = ?;

selectInProgress:
SELECT * FROM WorkoutSessionEntity WHERE endedAt IS NULL ORDER BY startedAt DESC LIMIT 1;

-- The routine's most recent session by start time, finished or not (drives the cycle, spec §3.4).
selectLatestForRoutine:
SELECT * FROM WorkoutSessionEntity WHERE routineId = ? ORDER BY startedAt DESC LIMIT 1;

selectFinished:
SELECT * FROM WorkoutSessionEntity WHERE endedAt IS NOT NULL ORDER BY startedAt DESC LIMIT :limit;

-- [from, to) in epoch millis, any state.
selectStartedBetween:
SELECT * FROM WorkoutSessionEntity WHERE startedAt >= :from AND startedAt < :to ORDER BY startedAt;

-- Data export (docs/EXPORT-FORMAT.md): all sessions oldest first, one page after the (startedAt, id) key.
-- Row values are not used: Android 7 ships SQLite 3.9.
selectExportPage:
SELECT * FROM WorkoutSessionEntity
WHERE startedAt > :afterStartedAt OR (startedAt = :afterStartedAt AND id > :afterId)
ORDER BY startedAt, id
LIMIT :limit;

-- History import (docs/IMPORT-FORMATS.md): a finished session written whole, with a deterministic id, linked to a
-- routine of this device when a Haltera export names one that exists.
insertImported:
INSERT INTO WorkoutSessionEntity(id, startedAt, endedAt, routineId, routineDayIndex, dayName, notes, bodyWeightGrams, routineName)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Which of :ids are already in the logbook.
selectExistingIds:
SELECT id FROM WorkoutSessionEntity WHERE id IN :ids;

-- Remapping a routine's day positions (fixed <-> flexible conversion) in two steps that cannot collide:
-- first each old index becomes -1 - new, then the negative ones are flipped back.
markDayIndexRemap:
UPDATE WorkoutSessionEntity SET routineDayIndex = -1 - :newIndex WHERE routineId = :routineId AND routineDayIndex = :oldIndex;

applyDayIndexRemap:
UPDATE WorkoutSessionEntity SET routineDayIndex = -1 - routineDayIndex WHERE routineId = :routineId AND routineDayIndex < 0;

-- A session of a routine day that a conversion removed (an empty rest day) no longer points at a day.
clearDayIndex:
UPDATE WorkoutSessionEntity SET routineDayIndex = NULL WHERE routineId = :routineId AND routineDayIndex = :oldIndex;

-- A routine was renamed on this phone: its sessions keep the new name (and upload it), so they keep it if the routine
-- is deleted later.
renameRoutine:
UPDATE WorkoutSessionEntity SET routineName = :name WHERE routineId = :routineId AND routineName IS NOT :name;
