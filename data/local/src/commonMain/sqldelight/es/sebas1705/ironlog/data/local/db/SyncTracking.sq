CREATE TRIGGER RoutineSlotEntity_syncInsert
AFTER INSERT ON RoutineSlotEntity
WHEN (SELECT value FROM Meta WHERE key = 'syncApplying') IS NOT '1'
BEGIN
    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = CASE WHEN EXISTS (SELECT 1 FROM RoutineEntity p WHERE p.id = (SELECT q.routineId FROM RoutineDayEntity q WHERE q.id = new.dayId)) THEN 0 ELSE 1 END
