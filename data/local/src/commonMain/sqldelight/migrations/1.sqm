CREATE TRIGGER RoutineDayEntity_syncInsert
AFTER INSERT ON RoutineDayEntity
WHEN (SELECT value FROM Meta WHERE key = 'syncApplying') IS NOT '1'
BEGIN
    UPDATE SyncState SET updatedAt = MAX(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), updatedAt + 1), dirty = 1, deleted = CASE WHEN EXISTS (SELECT 1 FROM RoutineEntity p WHERE p.id = new.routineId) THEN 0 ELSE 1 END
    WHERE collection = 'routines' AND id = new.routineId;
    INSERT INTO SyncState(collection, id, updatedAt, dirty, deleted)
    SELECT 'routines', new.routineId, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), 1, CASE WHEN EXISTS (SELECT 1 FROM RoutineEntity p WHERE p.id = new.routineId) THEN 0 ELSE 1 END
    WHERE new.routineId IS NOT NULL AND NOT EXISTS (SELECT 1 FROM SyncState s WHERE s.collection = 'routines' AND s.id = new.routineId);
END;
