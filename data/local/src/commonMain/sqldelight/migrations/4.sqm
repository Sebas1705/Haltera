-- Schema 4 -> 5: flexible rest days (docs/designs/2026-10-16-flexible-rest-days.md). Every existing routine
-- becomes FIXED (rest days are cycle positions), which is exactly how it behaved before.
ALTER TABLE RoutineEntity ADD COLUMN restMode TEXT NOT NULL DEFAULT 'FIXED';
ALTER TABLE RoutineEntity ADD COLUMN restDaysPerWeek INTEGER NOT NULL DEFAULT 0;
ALTER TABLE RoutineEntity ADD COLUMN restWeekdays INTEGER NOT NULL DEFAULT 0;
