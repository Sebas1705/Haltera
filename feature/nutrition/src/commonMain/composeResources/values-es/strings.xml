    <string name="nutrition_stats_average">Media diaria</string>
    <string name="nutrition_stats_average_info">Media de los días con comida apuntada. Los días sin entradas no cuentan como 0 kcal, porque un día sin apuntar es un dato que falta, no un ayuno.</string>
    <string name="nutrition_stats_kcal">Energía por día</string>
    <string name="nutrition_stats_kcal_info">Una barra por día apuntado; los huecos son días sin entradas. La línea discontinua es tu objetivo de kcal y las barras verdes están a ±10 % de él.</string>
    <string name="nutrition_stats_within">A ±10 % del objetivo</string>
    <string name="nutrition_stats_goal_line">Objetivo: %1$s kcal</string>
    <string name="nutrition_stats_macros">Macros por día</string>
    <string name="nutrition_stats_macros_info">Energía de cada macronutriente por día, apilada: proteínas e hidratos × 4 kcal/g, grasas × 9 kcal/g. El total puede diferir un poco de las kcal de los alimentos (fibra, alcohol y redondeos).</string>
    <string name="nutrition_stats_donut">Reparto medio de macros</string>
    <string name="nutrition_stats_donut_info">Parte de la energía que viene de las proteínas, los hidratos y las grasas en el periodo (4, 4 y 9 kcal por gramo).</string>
    <string name="nutrition_stats_adherence">Cumplimiento del objetivo</string>
    <string name="nutrition_stats_adherence_info">Porcentaje de días apuntados cuya energía estuvo a ±10 % del objetivo de kcal (con 2000 kcal: de 1800 a 2200).</string>
    <string name="nutrition_stats_adherence_no_goal">Fija un objetivo de kcal para ver cuántos días te quedas cerca.</string>
    <string name="nutrition_stats_adherence_value">%1$s de %2$s días apuntados a ±10 %</string>
    <string name="nutrition_stats_protein_kg">Proteína por kg</string>
    <string name="nutrition_stats_protein_kg_info">Proteína media diaria dividida entre tu último peso corporal. Para quien entrena, las referencias habituales rondan 1,6 a 2,2 g/kg.</string>
    <string name="nutrition_stats_protein_kg_no_weight">Apunta tu peso corporal en Progreso para ver la proteína por kg.</string>
    <string name="nutrition_stats_protein_kg_value">%1$s al día con %2$s kg</string>
    <string name="nutrition_stats_trend">Ingesta y peso corporal</string>
    <string name="nutrition_stats_trend_info">Medias móviles de 7 días de la energía consumida (eje izquierdo, kcal) y de tu peso corporal (eje derecho, kg), cada una sobre los días apuntados de los últimos 7 días naturales. Compararlas a lo largo de semanas muestra cómo se relaciona lo que comes con el cambio de peso; el peso diario oscila con el agua y la comida en el intestino.</string>
