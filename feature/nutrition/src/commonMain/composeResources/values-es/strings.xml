    <!-- Goals -->
    <string name="nutrition_daily_goals">Objetivos diarios</string>
    <string name="nutrition_goals_info">Todos los objetivos son opcionales y solo sirven de guía en la vista del día y en las estadísticas. Los macronutrientes se pueden indicar en gramos o como porcentaje del objetivo de kcal (las proteínas y los hidratos aportan 4 kcal por gramo y las grasas 9).</string>
