    <!-- Goals -->
    <string name="nutrition_daily_goals">Daily goals</string>
    <string name="nutrition_goals_info">All goals are optional and only guide the day view and the statistics. Macros can be entered in grams or as a percentage of the kcal goal (protein and carbohydrates have 4 kcal per gram, fat 9).</string>
