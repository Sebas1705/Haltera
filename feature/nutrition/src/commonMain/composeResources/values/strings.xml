    <string name="nutrition_stats_average">Daily average</string>
    <string name="nutrition_stats_average_info">Mean over the days with food logged. Days without entries are left out instead of counting as 0 kcal, because a missing day is unknown, not a fast.</string>
    <string name="nutrition_stats_kcal">Energy per day</string>
    <string name="nutrition_stats_kcal_info">One bar per logged day; empty slots are days without entries. The dashed line is your kcal goal and green bars are within ±10 % of it.</string>
    <string name="nutrition_stats_within">Within ±10 % of the goal</string>
    <string name="nutrition_stats_goal_line">Goal: %1$s kcal</string>
    <string name="nutrition_stats_macros">Macros per day</string>
    <string name="nutrition_stats_macros_info">Energy from each macro per day, stacked: protein and carbohydrates × 4 kcal/g, fat × 9 kcal/g. The total can differ slightly from the kcal of the foods (fibre, alcohol and rounding).</string>
    <string name="nutrition_stats_donut">Average macro split</string>
    <string name="nutrition_stats_donut_info">Share of the energy from protein, carbohydrates and fat over the period (4, 4 and 9 kcal per gram).</string>
    <string name="nutrition_stats_adherence">Goal adherence</string>
    <string name="nutrition_stats_adherence_info">Share of the logged days whose energy was within ±10 % of the kcal goal (for 2000 kcal: from 1800 to 2200).</string>
    <string name="nutrition_stats_adherence_no_goal">Set a kcal goal to see how many days stay close to it.</string>
    <string name="nutrition_stats_adherence_value">%1$s of %2$s logged days within ±10 %</string>
    <string name="nutrition_stats_protein_kg">Protein per kg</string>
    <string name="nutrition_stats_protein_kg_info">Average daily protein divided by your latest body weight. Common references for people who train are about 1.6 to 2.2 g/kg.</string>
    <string name="nutrition_stats_protein_kg_no_weight">Log your body weight in Progress to see protein per kg.</string>
    <string name="nutrition_stats_protein_kg_value">%1$s a day at %2$s kg</string>
    <string name="nutrition_stats_trend">Intake vs body weight</string>
    <string name="nutrition_stats_trend_info">7-day moving averages of the energy eaten (left axis, kcal) and of your body weight (right axis, kg), each over the logged days of the last 7 calendar days. Comparing them over weeks shows how eating relates to weight change; daily weight swings with water and food in the gut.</string>
    <string name="nutrition_stats_trend_kcal">kcal (7-day average)</string>
    <string name="nutrition_stats_trend_weight">Weight, kg (7-day average)</string>
